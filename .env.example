# ===== Tryb =====
# demo = dane syntetyczne (bez Google), live = Google Ads API + GA4
APP_MODE=demo
DB_PATH=/data/profitability.duckdb
MARGINS_SEED_FILE=/app/config/margins.csv
CATEGORY_MAP_FILE=/app/config/category_map.csv

# ===== Google Ads API =====
# Developer token z Centrum API konta MCC (min. Basic access)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth — scripts/google_ads_auth.py wygeneruje refresh token
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC, przez które jest dostęp (bez myślników)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Konto(a) reklamowe x-kom, po przecinku (bez myślników)
GOOGLE_ADS_CUSTOMER_IDS=
# Alternatywa dla OAuth: konto serwisowe z impersonacją użytkownika Google Ads
GOOGLE_ADS_JSON_KEY_FILE=
GOOGLE_ADS_IMPERSONATED_EMAIL=

# ===== GA4 =====
# data_api | bigquery
GA4_SOURCE=data_api
GA4_PROPERTY_ID=
# Konto serwisowe: Viewer w GA4 (Data API) lub BigQuery Data Viewer + Job User (BigQuery)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/ga4-service-account.json
# auto = aplikacja sprawdzi kompatybilność wymiarów z metrykami produktów
GA4_CAMPAIGN_DIMENSION=auto
GA4_CAMPAIGN_ID_DIMENSION=auto
# BigQuery export (gdy GA4_SOURCE=bigquery)
GA4_BQ_PROJECT=
GA4_BQ_DATASET=analytics_000000000
GA4_BQ_BILLING_PROJECT=

# ===== Model =====
GA4_REVENUE_INCLUDES_VAT=true
VAT_RATE=0.23
DEFAULT_MARGIN_PCT=10
# Zgodność ID produktu Merchant Center ↔ GA4
ITEM_ID_LOWERCASE=true
ITEM_ID_STRIP_REGEX=
# item_category | item_category2 | ... | item_category5
CATEGORY_FIELD=item_category
STATUS_LOSS_THRESHOLD=1.0
STATUS_EDGE_THRESHOLD=0.7

# ===== Synchronizacja =====
SYNC_ENABLED=true
SYNC_CRON=15 6 * * *
SYNC_TIMEZONE=Europe/Warsaw
SYNC_LOOKBACK_DAYS=3
INITIAL_BACKFILL_DAYS=90

# ===== Dostęp do dashboardu (puste = bez hasła) =====
DASHBOARD_USER=
DASHBOARD_PASSWORD=
